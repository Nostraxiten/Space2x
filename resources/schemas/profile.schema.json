{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Space2X Service Profile",
  "type": "object",
  "required": ["name", "version", "services"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": ["ensure_running", "ensure_stopped", "restart", "ignore"]
          },
          "autoStart": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
